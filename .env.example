# Copy this file to .env and fill in real values.
# Never commit the real .env file -- it is already gitignored.

# --- Application metadata ---------------------------------------------------
APP_NAME=TraceLens
APP_ENV=local
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Google Gemini (required starting the agent phase) ---------------------------
GOOGLE_API_KEY=

# --- LangSmith Observability (optional, Phase 3+) --------------------------------
# LangSmith is the primary observability platform for TraceLens.
# Set LANGCHAIN_TRACING_V2=true and provide LANGCHAIN_API_KEY to enable tracing.
#
# To obtain a LangSmith API key:
# 1. Create an account at https://smith.langchain.com
# 2. Copy your API key from the settings page
# 3. Paste it here (DO NOT commit this file if populated)
#
# Once configured, all agent executions will be traced in LangSmith.
# Traces show retrieval, tool calls, LLM invocations, and final decisions.
#
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tracelens
LANGCHAIN_TRACING_V2=false
# Optional: Custom LangSmith endpoint (leave empty for default production endpoint)
# LANGCHAIN_ENDPOINT=

# --- Persistence (required starting the database phase) ----------------------------
DATABASE_URL=sqlite:///./tracelens.db

# --- Model ------------------------------------------------------------------------
MODEL_NAME=gemini-2.5-flash

# --- CORS (comma-separated origins, empty disables CORS) ---------------------------
CORS_ALLOW_ORIGINS=
